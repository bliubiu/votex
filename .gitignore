# ===== 构建产物 =====
/target/

# ===== 模型与运行时资产（35G+，不入库，另行分发） =====
# 只忽略模型权重与 ONNX Runtime 动态库；**清单定义必须入库**，
# 否则 clone 仓库后没有 models/registry/*.yaml，模型列表为空、无法下载，
# 且已回填的 SHA256 会随本地文件一起丢失（详见 docs/23 审查报告）。
/models/*
!/models/registry/

# ===== 测试与临时产物 =====
/tmp/*
# 标准测试素材（集成测试硬依赖，见 docs/20 §2.6 / CHANGELOG 测试素材基准）
!/tmp/e2e_ch1.txt
!/tmp/novel.txt

# ===== 资源与运行数据 =====
/resource/
/data/
/logs/
output/

# ===== 密钥与证书 =====
.key
*.key
*.pem
*.pfx
*.p12

# ===== 本地工具目录 =====
/.workbuddy/
/.codegraph/
/.omo/
/.agents/
/.cache/
/.sisyphus/
/.trae/

# ===== 系统文件 =====
Thumbs.db
.DS_Store
crates/votex-infra/test_*.wav
